{{- /* Root-only environment file with the passwords. DFLY_<flag> sets a Dragonfly flag. */ -}}
{{- if .input.password }}
DFLY_requirepass={{ .input.password }}
{{- end }}
{{- if .input.master_auth }}
DFLY_masterauth={{ .input.master_auth }}
{{- end }}
{{- if .vars.s3_access_key }}
AWS_ACCESS_KEY_ID={{ .vars.s3_access_key }}
AWS_SECRET_ACCESS_KEY={{ .vars.s3_secret_key }}
{{- end }}
{{- if .vars.s3_region }}
AWS_REGION={{ .vars.s3_region }}
{{- end }}
{{- range $name, $value := .input.extra_env }}
{{ $name }}={{ $value }}
{{- end }}
