{{- /*
  The environment file for the dragonfly unit: 0600, root-only, loaded by systemd before the
  process starts. It carries the secrets this unit handles — the password and the replication
  password — so they never land in the world-readable unit file or in the flagfile on disk.

  Dragonfly accepts any of its flags as an environment variable named DFLY_ followed by the flag
  spelled EXACTLY as on the command line: DFLY_requirepass works, DFLY_REQUIREPASS does not, and
  an unrecognised DFLY_ name makes the process abort on startup rather than ignore it. Only the
  DFLY_ prefix is policed, so the AWS variables below pass through untouched — and they are the
  only way to give Dragonfly S3 credentials, as it has no flags for them.

  An empty password renders NO line at all: an empty DFLY_requirepass would configure a password
  that is the empty string. Absent means absent.
*/ -}}
{{- if .input.password }}
DFLY_requirepass={{ .input.password }}
{{- end }}
{{- if .input.master_auth }}
DFLY_masterauth={{ .input.master_auth }}
{{- end }}
{{- if .vars.s3_access_key }}
AWS_ACCESS_KEY_ID={{ .vars.s3_access_key }}
AWS_SECRET_ACCESS_KEY={{ .vars.s3_secret_key }}
{{- end }}
{{- if .vars.s3_region }}
AWS_REGION={{ .vars.s3_region }}
{{- end }}
{{- range $name, $value := .input.extra_env }}
{{ $name }}={{ $value }}
{{- end }}
