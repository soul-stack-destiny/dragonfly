{{- /* Deletes snapshot files older than snapshot_retention_days. */ -}}
[Unit]
Description=Prune Dragonfly snapshots older than {{ .input.snapshot_retention_days }} days
Documentation=https://www.dragonflydb.io/docs

[Service]
Type=oneshot
User={{ .input.user }}
Group={{ .input.group }}
ExecStart=/bin/sh -c 'find {{ .input.data_dir }} -maxdepth 1 -type f -name "*.dfs" -mtime +{{ .input.snapshot_retention_days }} -delete'
ExecStart=/bin/sh -c 'find {{ .input.data_dir }} -maxdepth 1 -type f -name "*.rdb" -mtime +{{ .input.snapshot_retention_days }} -delete'

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
ProtectProc=invisible
CapabilityBoundingSet=
UMask=0027
ReadWritePaths={{ .input.data_dir }}
