{{- /* systemd unit for Dragonfly. Passwords come from the root-only EnvironmentFile, not from here. */ -}}
[Unit]
Description=Dragonfly in-memory datastore
Documentation=https://www.dragonflydb.io/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ .input.user }}
Group={{ .input.group }}
WorkingDirectory={{ .input.data_dir }}
EnvironmentFile={{ .vars.env_path }}
ExecStart={{ .vars.bin_path }} --flagfile {{ .vars.config_path }}
SyslogIdentifier=dragonfly
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
# Shutdown may write a snapshot of the whole dataset.
TimeoutStopSec=1800
LimitNOFILE=262144

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
ProtectProc=invisible
MemoryDenyWriteExecute=yes
# Dragonfly raises its own resource limits at startup.
CapabilityBoundingSet=CAP_SYS_RESOURCE
UMask=0027
ReadWritePaths={{ .input.data_dir }} {{ .input.log_dir }}

[Install]
WantedBy=multi-user.target
