{{- /* One line per user, password as a sha256 hash. No comment lines here: Dragonfly would reject the whole file. */ -}}
user default on #{{ .input.password | sha256sum }} {{ .input.default_perms }}
{{- if .vars.admin_account_enabled }}
user {{ .input.admin_user }} on #{{ .input.admin_password | sha256sum }} {{ .vars.admin_perms }}
{{- end }}
{{- range $name, $u := .input.users }}
user {{ $name }} {{ $u.state }} #{{ $u.password | sha256sum }} {{ $u.perms }}
{{- end }}
